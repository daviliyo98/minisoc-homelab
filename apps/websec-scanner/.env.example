# Copia como .env y pon una clave larga y aleatoria. .env NO se sube al repositorio.
# Generar una: openssl rand -hex 32
API_KEY=cambia-esto-por-una-clave-larga-aleatoria

# Modo activo (escaneo de vulnerabilidades con Nuclei). Desactivado por defecto.
# Ponlo a 1 SOLO si vas a usarlo, y úsalo únicamente sobre objetivos autorizados.
# NOTA: también habilita el escaneo ACTIVO de ZAP (inyección SQLi/XSS).
ACTIVE_SCAN_ENABLED=0

# --- Integración con OWASP ZAP (spider + pasivo, y activo tras el triple candado) ---
# Arranca el contenedor ZAP con:  docker compose --profile zap up -d
# ZAP_ENABLED=1 habilita las pestañas de ZAP en el scanner.
ZAP_ENABLED=0
# Clave de la API de ZAP (obligatoria). Genera una:  openssl rand -hex 16
ZAP_API_KEY=cambia-esto-por-una-clave-aleatoria

# --- Claves con roles (opcional; sustituye o complementa a API_KEY) ---
# Formato: nombre:rol:clave separadas por comas. Roles: pasivo | activo | admin.
# API_KEYS=fran:admin:<hex>,cliente1:pasivo:<hex>,pentest:activo:<hex>
API_KEYS=
RATE_LIMIT_PER_MIN=60
# Escaneos activos (Nuclei/ZAP/testssl) simultáneos; el resto espera en cola.
JOBS_MAX_CONCURRENT=1
# 1 = los escaneos activos solo contra dominios verificados por DNS (POST /verify).
REQUIRE_VERIFIED_DOMAIN=0

# --- Monitorización continua y alertas ---
MONITOR_ENABLED=1
ALERT_MIN_CVSS=4.0
ALERT_CERT_DAYS=21
# Webhook genérico (Slack, Discord, Mattermost, ntfy…): recibe {"text": ..., "content": ...}
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Si se define, /metrics exige "Authorization: Bearer <token>"
METRICS_TOKEN=
