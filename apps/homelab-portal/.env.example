# Credenciales del portal. Copia como .env y ajusta.
# .env NO se sube al repositorio.

# Usuario para HTTP básico.
PORTAL_USER=admin

# Contraseña. Generar una:  openssl rand -hex 24
# Si se deja vacía, el portal arranca SIN autenticación (lo avisa por log).
PORTAL_PASSWORD=cambia-esto-por-una-clave-larga-aleatoria

# Ubicación de la sección Entorno (tiempo, terremotos, noticias). Opcional.
# Va aquí y no en services.yaml para no publicar en GitHub dónde está la Pi.
ENTORNO_NOMBRE=Granada
ENTORNO_LAT=
ENTORNO_LON=
ENTORNO_RADIO_KM=150

# Pi-hole v6 para la sección Dispositivos (consultas DNS por aparato). Opcional.
# Usa una contraseña de aplicación: Pi-hole > Settings > Web interface / API >
# "Configure app password". Se revoca sin tocar la de administrador.
PIHOLE_API=http://127.0.0.1/api
PIHOLE_PASSWORD=
